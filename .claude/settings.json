{
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "Bash(git *)",
      "Bash(gh *)",
      "mcp__github__*"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Read(**/.env)",
      "Read(**/.env.*)"
    ]
  }
}
