{
  "description": "yk-kit safety floor: deterministic deny list for Bash (fires even in bypass mode)",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/bash-guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
